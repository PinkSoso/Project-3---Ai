# LLM
# Option A: Local Ollama (zero cost, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Option B: GitHub Models GPT-4o — comment out the Ollama vars above if using this
GITHUB_MODELS_API_KEY=your_github_models_key_here
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o

# Which provider to use: ollama or github_models
LLM_PROVIDER=ollama

# Database
# Hosted by one team member locally. Replace HOST_IP with their IP address.
# They can find it by running ipconfig in PowerShell and looking for IPv4 Address.
POSTGRES_HOST=192.168.1.XX
POSTGRES_PORT=5432
POSTGRES_DB=lumino
POSTGRES_USER=lumino
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://lumino:your_password_here@192.168.1.XX:5432/lumino_ab_agent

# Listmonk
LISTMONK_BASE_URL=http://localhost:9000
LISTMONK_USERNAME=admin
LISTMONK_PASSWORD=your_listmonk_password_here

# Mailhog
MAILHOG_SMTP_HOST=localhost
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_URL=http://localhost:8025

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ab_testing_agent

# Streamlit
STREAMLIT_PORT=8501

# Brand config
LUMINO_BRAND_NAME=Lumino
LUMINO_FROM_EMAIL=hello@lumino.example
LUMINO_FROM_NAME=Lumino
